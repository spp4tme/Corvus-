# Corvus doit rester 100 % pur JS (Raspberry Pi ARM64 comme PC) :
# - pas de dépendances optionnelles natives (cpu-features, bufferutil, utf-8-validate…)
# - pas de scripts d'installation (ssh2 tenterait de compiler un binding crypto optionnel)
omit=optional
ignore-scripts=true
fund=false
audit=false
